# Copier ce fichier en « .env » et compléter.
# Les réglages « métier » (critères, seuils, pondérations…) se font dans l'application.

# Mot de passe de la base de données (choisissez-en un long)
POSTGRES_PASSWORD=changez-moi

# Adresse d'écoute de l'application.
# Sur votre PC : 127.0.0.1. Sur le serveur : l'adresse Tailscale (100.x.y.z).
APP_BIND=127.0.0.1

# Clés API (à renseigner aux étapes concernées)
ANTHROPIC_API_KEY=
TOMTOM_API_KEY=

# Facultatif : adresse de contact ajoutée au user-agent du robot de collecte
CONTACT_EMAIL=
